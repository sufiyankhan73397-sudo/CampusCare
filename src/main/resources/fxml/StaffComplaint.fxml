<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.campuscare.controller.StaffComplaintController" spacing="12" styleClass="view-pane">
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
        <TextField fx:id="searchField" promptText="Search by id, title, location, category..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="statusFilter" prefWidth="140"/>
        <ComboBox fx:id="priorityFilter" prefWidth="120"/>
        <ComboBox fx:id="categoryFilter" prefWidth="150"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <Label text="Remarks (required for Resolve, optional otherwise)"/>
    <TextArea fx:id="remarksArea" prefRowCount="3" wrapText="true" promptText="What was done? Visible in the student's timeline."/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
        <Button fx:id="detailsButton" text="Details" onAction="#onDetails" styleClass="secondary-button"/>
        <Button fx:id="acceptButton" text="Accept" onAction="#onAccept" styleClass="primary-button"/>
        <Button fx:id="startButton" text="Start Work" onAction="#onStart" styleClass="primary-button"/>
        <Button fx:id="resolveButton" text="Mark Resolved" onAction="#onResolve" styleClass="success-button"/>
    </HBox>
</VBox>
