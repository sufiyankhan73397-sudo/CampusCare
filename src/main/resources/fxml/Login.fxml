<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.campuscare.controller.LoginController" styleClass="login-root">
    <HBox styleClass="login-card" maxWidth="880" maxHeight="520" alignment="CENTER">
        <VBox styleClass="login-brand" prefWidth="380" minWidth="380" spacing="14" alignment="CENTER_LEFT">
            <Label text="CampusCare" styleClass="login-title"/>
            <Label text="Smart Campus Issue Management and Resolution System" wrapText="true" styleClass="login-subtitle"/>
            <Label text="Report. Track. Resolve." styleClass="login-tagline"/>
        </VBox>
        <VBox styleClass="login-form" prefWidth="500" spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <Label text="Sign in" styleClass="form-title"/>
            <Label text="Email"/>
            <TextField fx:id="emailField" promptText="you@example.com"/>
            <Label text="Password"/>
            <PasswordField fx:id="passwordField" promptText="Password" onAction="#onLogin"/>
            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
            <Button text="Login" onAction="#onLogin" styleClass="primary-button" maxWidth="Infinity"/>
            <HBox alignment="CENTER" spacing="4">
                <Label text="New student?"/>
                <Hyperlink text="Create an account" onAction="#onRegister"/>
            </HBox>
        </VBox>
    </HBox>
</StackPane>
