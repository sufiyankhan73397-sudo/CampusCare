<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.campuscare.controller.AdminComplaintsController" spacing="12" styleClass="view-pane">
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
        <TextField fx:id="searchField" promptText="Search by id, title, location, category..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="statusFilter" prefWidth="140"/>
        <ComboBox fx:id="priorityFilter" prefWidth="120"/>
        <ComboBox fx:id="categoryFilter" prefWidth="150"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
        <Label fx:id="departmentHint" text="Select a complaint to assign staff."/>
        <ComboBox fx:id="staffBox" promptText="Select staff" prefWidth="220"/>
        <Button fx:id="assignButton" text="Assign" onAction="#onAssign" styleClass="primary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="detailsButton" text="Details" onAction="#onDetails" styleClass="secondary-button"/>
        <Button text="Export CSV" onAction="#onExport" styleClass="secondary-button"/>
        <Button text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
    </HBox>
</VBox>
