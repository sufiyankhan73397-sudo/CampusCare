<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.campuscare.controller.CategoryController" spacing="12" styleClass="view-pane">
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <VBox styleClass="card" spacing="8">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="nameField" promptText="Category name" prefWidth="260"/>
            <ComboBox fx:id="departmentBox" promptText="Responsible department" prefWidth="240"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Clear" onAction="#onClear" styleClass="secondary-button"/>
            <Button text="Delete" onAction="#onDelete" styleClass="danger-button"/>
            <Button text="Update Selected" onAction="#onUpdate" styleClass="secondary-button"/>
            <Button text="Add Category" onAction="#onAdd" styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
